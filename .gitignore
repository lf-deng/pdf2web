*.pdf
course/site/**/*
*.jpg
!course/docs/images/*.jpg

# Local course sources and generated output

/course/site/

# Preserve the course PDFs and generated figures in Git
!course/resources/pdfs/*.pdf
!course/docs/images/*.jpg

!course/resources/mineru/*/images/*.jpg
